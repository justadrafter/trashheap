<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Keep palette keys identical to Theme.Light.xaml. -->
    <SolidColorBrush x:Key="QrWindowBrush" Color="#202020"/>
    <SolidColorBrush x:Key="QrForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="QrSubtleBrush" Color="#C5FFFFFF"/>
    <SolidColorBrush x:Key="QrWarningBrush" Color="#FF8080"/>
    <SolidColorBrush x:Key="QrDisabledBrush" Color="#5DFFFFFF"/>
    <SolidColorBrush x:Key="QrControlBrush" Color="#4C3A3A3A"/>
    <SolidColorBrush x:Key="QrPanelBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="QrTooltipBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="QrBorderBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="QrButtonBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="QrButtonHoverBrush" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="QrButtonPressedBrush" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="QrButtonDisabledBrush" Color="#0BFFFFFF"/>
    <SolidColorBrush x:Key="QrHoverBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="QrSelectionBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="QrSelectionForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="QrFocusBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="QrScrollThumbBrush" Color="#8BFFFFFF"/>
    <LinearGradientBrush x:Key="QrButtonBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#18FFFFFF"/>
        <GradientStop Offset="0.1" Color="#18FFFFFF"/>
        <GradientStop Offset="1" Color="#12FFFFFF"/>
    </LinearGradientBrush>
</ResourceDictionary>

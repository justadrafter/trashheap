<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create QR code"
        Width="640" Height="300" MinWidth="540" MinHeight="300"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource QrWindowBrush}"
        Foreground="{DynamicResource QrForegroundBrush}">
    <Grid Margin="20,12,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Web address or text" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBox x:Name="InputText" MinHeight="40"
                     VerticalContentAlignment="Center"
                     ToolTip="Enter the exact web address or text to encode in the QR code."/>
        </StackPanel>

        <Border Grid.Row="2" Margin="0,16,0,0" Padding="12,10" CornerRadius="4"
                Background="{DynamicResource QrPanelBrush}"
                BorderBrush="{DynamicResource QrBorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="InputStatus" Text="The PNG will be saved to:" TextWrapping="Wrap"/>
                <TextBlock x:Name="OutputPath" Margin="0,4,0,0" TextWrapping="Wrap"
                           Style="{DynamicResource QrCaptionStyle}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="GenerateButton" Content="Generate QR code" IsDefault="True"
                    MinWidth="140" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>

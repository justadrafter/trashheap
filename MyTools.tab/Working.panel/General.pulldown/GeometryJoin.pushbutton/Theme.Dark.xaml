<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Keep palette keys identical to Theme.Light.xaml. -->
    <SolidColorBrush x:Key="MaterialWindowBrush" Color="#202020"/>
    <SolidColorBrush x:Key="MaterialForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MaterialSubtleBrush" Color="#C5FFFFFF"/>
    <SolidColorBrush x:Key="MaterialWarningBrush" Color="#FF8080"/>
    <SolidColorBrush x:Key="MaterialDisabledBrush" Color="#5DFFFFFF"/>
    <SolidColorBrush x:Key="MaterialControlBrush" Color="#4C3A3A3A"/>
    <SolidColorBrush x:Key="MaterialPanelBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="MaterialTooltipBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="MaterialBorderBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="MaterialButtonBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="MaterialButtonHoverBrush" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="MaterialButtonPressedBrush" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="MaterialButtonDisabledBrush" Color="#0BFFFFFF"/>
    <SolidColorBrush x:Key="MaterialHoverBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="MaterialSelectionBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="MaterialSelectionForegroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="MaterialFocusBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="MaterialScrollThumbBrush" Color="#8BFFFFFF"/>
    <LinearGradientBrush x:Key="MaterialButtonBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#18FFFFFF"/>
        <GradientStop Offset="0.1" Color="#18FFFFFF"/>
        <GradientStop Offset="1" Color="#12FFFFFF"/>
    </LinearGradientBrush>
</ResourceDictionary>
